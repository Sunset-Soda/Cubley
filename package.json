{
  "name": "cubely",
  "productName": "Cubely",
  "version": "1.0.0",
  "description": "Cube scrambler, solver and timer",
  "author": "Cubely",
  "main": "main.js",
  "scripts": {
    "fonts": "node scripts/get-fonts.js",
    "start": "npm run fonts && electron .",
    "dist": "npm run fonts && electron-builder --linux AppImage",
    "dist:win": "npm run fonts && electron-builder --win nsis",
    "dist:mac": "npm run fonts && electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "app.cubely.desktop",
    "productName": "Cubely",
    "files": [
      "main.js",
      "index.html",
      "build/icon.png",
      "fonts/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Cubely-${version}.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Cubely-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "Cubely-${version}-mac-${arch}.dmg",
      "identity": null
    }
  }
}